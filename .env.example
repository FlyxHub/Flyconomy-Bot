# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Required. Bot token from https://discord.com/developers/applications
# -> your application -> Bot -> Reset Token.
FLYCONOMY_DISCORD_TOKEN=

# Optional. Path to the SQLite database. The directory is created if missing.
# The Docker Compose service overrides this to a path inside the mounted volume.
FLYCONOMY_DATABASE_PATH=data/bot.db

# Optional. Prefix for classic text commands. Slash commands ignore it.
FLYCONOMY_COMMAND_PREFIX=$

# Optional. IANA timezone used for timestamps on embeds.
FLYCONOMY_TIMEZONE=America/Chicago

# Optional. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
FLYCONOMY_LOG_LEVEL=INFO

# Optional. Set to a server ID while developing so slash commands appear
# immediately in that server. Leave empty in production to sync globally.
FLYCONOMY_DEV_GUILD_ID=

# Optional. Comma-separated user IDs whose mine attempts always succeed.
FLYCONOMY_ALWAYS_MINE_USER_IDS=

# Optional. Table limit: the most a member may stake on one wager.
FLYCONOMY_MAX_BET=100000

# Optional. Ceiling on the Flyxcoin one member may buy in a day. The market
# mean-reverts and quotes one price to buyer and seller, so buying low and
# selling high pays a percentage of the member's whole bank; this ceiling is
# what keeps that linear over a season instead of compounding.
FLYCONOMY_MAX_FLX_BUY=100

# Optional. Anti-spam limit on game commands, per member.
FLYCONOMY_RATE_LIMIT_ACTIONS=6
FLYCONOMY_RATE_LIMIT_SECONDS=10

# Optional. Daily interest: the ceiling on one account's payout, and the time
# it is paid each day (24-hour HH:MM, in FLYCONOMY_TIMEZONE). The payout is 10%
# of the bank, which compounds, so the ceiling is what keeps a season from
# hyperinflating. It is paid automatically to every account -- there is no
# command to claim it.
FLYCONOMY_MAX_DAILY_PAYOUT=10000
FLYCONOMY_DAILY_PAYOUT_TIME=08:00

# Optional. Lottery: entry price, share of the casino's net winnings added to
# the pot, and the daily draw time (24-hour HH:MM, in FLYCONOMY_TIMEZONE).
FLYCONOMY_LOTTERY_TICKET_PRICE=10000
FLYCONOMY_LOTTERY_RAKE=0.25
FLYCONOMY_LOTTERY_DRAW_TIME=18:00

# Optional. Channel ID for the bot's announcements: each lottery draw's winner,
# and the daily interest run. Leave empty to skip them; the draw and the payout
# both happen either way.
FLYCONOMY_LOTTERY_ANNOUNCE_CHANNEL_ID=

# Optional. Creator tax: share of the casino's net winnings paid into the
# bank balance of FLYCONOMY_CREATOR_TAX_USER_ID, carved out of the portion the
# lottery rake leaves for destruction (so the pot's cut and the total taken
# from a loss are unchanged). Has no effect until the user ID below is set.
# That user is also DMed whenever a Flyxcoin bull or bear run starts.
FLYCONOMY_CREATOR_TAX_RATE=0.05
FLYCONOMY_CREATOR_TAX_USER_ID=

# Optional. Share of a `pay` transfer withheld as tax. Half feeds the lottery
# pot and half goes to FLYCONOMY_CREATOR_TAX_USER_ID; the creator's half is
# destroyed instead while that is unset. Capped at 0.5.
FLYCONOMY_TRANSFER_TAX_RATE=0.05

# Optional. Channel ID the bot posts the member-facing economy guide to, then
# edits in place whenever the guide's text changes. Leave empty to publish
# nothing; everything else works either way.
FLYCONOMY_GUIDE_CHANNEL_ID=
