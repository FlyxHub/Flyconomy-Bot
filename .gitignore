# Secrets
.env
.env.*
!.env.example

# Database
*.db
*.db-wal
*.db-shm
# Anchored: this is the runtime database directory at the repository root. An
# unanchored `data/` also matches `src/flyconomy/data/`, and because the build
# backend honours these rules that silently drops the packaged economy guide
# out of the wheel.
/data/

